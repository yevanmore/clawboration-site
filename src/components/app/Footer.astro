---
import AppLogo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import config from "@util/themeConfig";

const socials = Object.values(config.footer.socials);
const socialNames = Object.keys(config.footer.socials);
const tags = config.directoryData.tags?.slice(0, 4) || [];
const actionLink = (() => {
  try {
    const url = new URL(config.header.actionButton.href);
    return url.pathname || "/";
  } catch (error) {
    return config.header.actionButton.href;
  }
})();

const navigation = [
  {
    title: "Explore",
    links: [
      { title: "Compare", link: "/compare" },
      { title: "Alternatives", link: "/alternatives" },
      { title: "Best", link: "/best" },
    ],
  },
  {
    title: "Build",
    links: [
      { title: "Use Cases", link: "/use-cases" },
      { title: "Playbooks", link: "/playbooks" },
      { title: "Templates", link: "/templates" },
    ],
  },
  {
    title: "Topics",
    links: tags.map((tag) => ({
      title: tag.name,
      link: `/tags/${tag.key}`,
    })),
  },
  {
    title: "Next",
    links: [{ title: config.header.actionButton.text, link: actionLink }],
  },
];
---

<footer
  class="border-t border-gray-200 dark:border-gray-600 font-display"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <AppLogo />
        <p class="max-w-sm text-sm leading-6 text-gray-600 dark:text-gray-300">
          {config.footer.description}
        </p>
        {
          socials.length > 0 && (
            <div class="flex space-x-6">
              {
                socials.map((item, index) => (
                  <a href={item?.link} class="text-gray-400 hover:text-gray-500">
                    <span class="sr-only">{item}</span>
                    <Icon
                      name={
                        config.ui.icons[
                          socialNames[index] as keyof typeof config.ui.icons
                        ]
                      }
                      class="h-6 w-6"
                      aria-hidden="true"
                    />
                  </a>
                ))
              }
            </div>
          )
        }
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0 md:grid-cols-4">
        {
          navigation.map((group) => (
            <div>
              <h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">
                {group.title}
              </h3>
              <ul role="list" class="mt-6 space-y-4">
                {group.links.map((item) => (
                  <li>
                    <a
                      href={item.link}
                      class="text-sm leading-6 text-gray-600 dark:text-gray-300 hover:dark:text-gray-400 hover:text-gray-900"
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="mt-16 border-t border-gray-900/10 dark:border-gray-600 pt-8 sm:mt-20 lg:mt-24"
    >
      <p class="text-xs leading-5 text-gray-500">
        &copy; {new Date().getFullYear()}
        {config.general.title} All rights reserved.
      </p>
    </div>
  </div>
</footer>
