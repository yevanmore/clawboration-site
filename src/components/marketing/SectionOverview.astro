---
const sections = [
  {
    href: "/compare",
    title: "Compare",
    description: "Side-by-side decision briefs for buyers evaluating category leaders and direct competitors.",
  },
  {
    href: "/alternatives",
    title: "Alternatives",
    description: "High-intent replacement pages for teams already looking to switch or re-evaluate a vendor.",
  },
  {
    href: "/best",
    title: "Best",
    description: "Curated shortlists built around jobs to be done, team size, and deployment constraints.",
  },
  {
    href: "/use-cases",
    title: "Use Cases",
    description: "Scenario pages that connect real jobs to product value, templates, and implementation paths.",
  },
  {
    href: "/playbooks",
    title: "Playbooks",
    description: "Practical rollout guides that move readers from problem framing into execution and adoption.",
  },
  {
    href: "/templates",
    title: "Templates",
    description: "Reusable starting points that turn SEO traffic into concrete next steps and product trials.",
  },
];
---

<div class="not-prose my-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  {
    sections.map((section) => (
      <a
        href={section.href}
        class="rounded-2xl border border-gray-200 bg-white p-5 transition-colors hover:border-primary-300 hover:bg-primary-50/50 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-primary-700 dark:hover:bg-primary-950/20"
      >
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-700 dark:text-primary-300">
          {section.title}
        </p>
        <h2 class="mt-3 text-xl font-semibold text-gray-900 dark:text-gray-50">
          {section.title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
          {section.description}
        </p>
      </a>
    ))
  }
</div>
