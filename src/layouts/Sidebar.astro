---
import SidebarShell from "@components/app/SidebarShell.astro";
import Prose from "../components/app/Prose.astro";
import BaseLayout from "./BaseLayout.astro";

const { title, description, slug } = Astro.props;
---

<BaseLayout title={title} description={description} slug={slug}>
  <SidebarShell>
    <div class="max-w-3xl xl:max-w-6xl px-5 py-10 mx-auto">
      <Prose>
        <slot />
      </Prose>
    </div>
  </SidebarShell>
</BaseLayout>
